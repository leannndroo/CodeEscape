<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nivel1">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000" />

    <TextView
        android:id="@+id/tvPyLevel2Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:fontFamily="monospace"
        android:text="🐍 PYTHON — NIVEL 2"
        android:textColor="#00FF41"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="#AA000000"
        android:padding="6dp"/>

    <TextView
        android:id="@+id/tvPyProgress2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="monospace"
        android:text="PROGRESO: [ ] [ ] [ ]"
        android:textColor="#00FF41"
        android:textSize="12sp"
        android:background="#AA000000"
        android:padding="6dp"/>

    <TextView
        android:id="@+id/tvPyStatus2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvPyLevel2Title"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:text="Las listas guardan los secretos..."
        android:textColor="#00AA2A"
        android:textSize="11sp"
        android:background="#AA000000"
        android:padding="4dp"/>

    <!-- PIZARRA izquierda -->
    <LinearLayout
        android:id="@+id/layoutBoard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="24dp"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/btnBoard"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:backgroundTint="#AA1A3A1A"
            android:fontFamily="monospace"
            android:text="📋 PIZARRA"
            android:textColor="#00FF41"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvBoardStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="PISTA 1"
            android:textColor="#00FF41"
            android:textSize="10sp"
            android:background="#AA000000"
            android:padding="3dp"/>

    </LinearLayout>

    <!-- PUERTA centro -->
    <LinearLayout
        android:id="@+id/layoutPyDoor2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/btnPyDoor2"
            android:layout_width="90dp"
            android:layout_height="130dp"
            android:backgroundTint="#AA1A1A1A"
            android:fontFamily="monospace"
            android:text="🚪&#10;PUERTA"
            android:textColor="#555555"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPyDoorStatus2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="BLOQUEADA"
            android:textColor="#FF0000"
            android:textSize="10sp"
            android:background="#AA000000"
            android:padding="3dp"/>

    </LinearLayout>

    <!-- TERMINAL derecha -->
    <LinearLayout
        android:id="@+id/layoutTerminal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/btnTerminal"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:backgroundTint="#AA1A1A3A"
            android:fontFamily="monospace"
            android:text="🖥️ TERMINAL"
            android:textColor="#00FF41"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTerminalStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="PISTA 2"
            android:textColor="#00FF41"
            android:textSize="10sp"
            android:background="#AA000000"
            android:padding="3dp"/>

    </LinearLayout>

    <Button
        android:id="@+id/btnBackPy2"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#AA1A1A1A"
        android:fontFamily="monospace"
        android:text="← VOLVER"
        android:textColor="#00FF41"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnVolume"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#AA1A1A1A"
        android:text="🔊"
        android:textSize="16sp"
        android:padding="0dp" />

</RelativeLayout>