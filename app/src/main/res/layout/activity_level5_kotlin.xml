<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nivel1">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000" />

    <TextView
        android:id="@+id/tvKtLevel5Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:fontFamily="monospace"
        android:text="🤖 KOTLIN — CORRUPTO 🌀"
        android:textColor="#CC3EFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="#AA000000"
        android:padding="6dp"/>

    <TextView
        android:id="@+id/tvKtProgress5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="monospace"
        android:text="PROGRESO: [ ] [ ] [ ]"
        android:textColor="#CC3EFF"
        android:textSize="12sp"
        android:background="#AA000000"
        android:padding="6dp"/>

    <TextView
        android:id="@+id/tvKtStatus5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvKtLevel5Title"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:text="El sistema de herencia está corrompido..."
        android:textColor="#9900CC"
        android:textSize="11sp"
        android:background="#AA000000"
        android:padding="4dp"/>

    <!-- OBJETO 1 -->
    <LinearLayout
        android:id="@+id/layoutKtBtn1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="24dp"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/btnKtObj1"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:backgroundTint="#AA2A003A"
            android:fontFamily="monospace"
            android:text="🧬 HERENCIA"
            android:textColor="#CC3EFF"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="OBJETO 1"
            android:textColor="#CC3EFF"
            android:textSize="10sp"
            android:background="#AA000000"
            android:padding="3dp"/>

    </LinearLayout>

    <!-- PUERTA centro -->
    <LinearLayout
        android:id="@+id/layoutKtDoor5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/btnKtDoor5"
            android:layout_width="90dp"
            android:layout_height="130dp"
            android:backgroundTint="#AA1A001A"
            android:fontFamily="monospace"
            android:text="🚪
LEGADO"
            android:textColor="#555555"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvKtDoorStatus5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="BLOQUEADA"
            android:textColor="#FF0000"
            android:textSize="10sp"
            android:background="#AA000000"
            android:padding="3dp"/>

    </LinearLayout>

    <!-- OBJETO 2 -->
    <LinearLayout
        android:id="@+id/layoutKtBtn2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/btnKtObj2"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:backgroundTint="#AA1A003A"
            android:fontFamily="monospace"
            android:text="🔓 OPEN"
            android:textColor="#CC3EFF"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="OBJETO 2"
            android:textColor="#CC3EFF"
            android:textSize="10sp"
            android:background="#AA000000"
            android:padding="3dp"/>

    </LinearLayout>

    <!-- Botón volver -->
    <Button
        android:id="@+id/btnBackKt5"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#AA1A1A1A"
        android:fontFamily="monospace"
        android:text="← VOLVER"
        android:textColor="#CC3EFF"
        android:textSize="12sp" />

    <!-- Botón volumen -->
    <Button
        android:id="@+id/btnVolume"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#AA1A1A1A"
        android:text="🔊"
        android:textSize="16sp"
        android:padding="0dp" />

</RelativeLayout>