<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000" />

    <!-- Título -->
    <TextView
        android:id="@+id/tvTutorialTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:fontFamily="monospace"
        android:text="CÓMO JUGAR"
        android:textColor="#00FF41"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="#AA000000"
        android:padding="6dp"/>

    <View
        android:id="@+id/lineDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/tvTutorialTitle"
        android:layout_marginTop="6dp"
        android:background="#00FF41" />

    <!-- Hint deslizar -->
    <TextView
        android:id="@+id/tvSwipeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/lineDivider"
        android:fontFamily="monospace"
        android:gravity="end"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:text="← desliza horizontal →"
        android:textColor="#444444"
        android:textSize="10sp"/>

    <!-- Botones abajo -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnSkip"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="#1A1A1A"
            android:fontFamily="monospace"
            android:text="SALTAR"
            android:textColor="#555555"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnStartGame"
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:backgroundTint="#00FF41"
            android:fontFamily="monospace"
            android:text="¡EMPEZAR!"
            android:textColor="#0A0A0A"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:id="@+id/lineAboveBtn"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/layoutButtons"
        android:background="#00FF41" />

    <!-- Indicador de páginas -->
    <TextView
        android:id="@+id/tvPageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/lineAboveBtn"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="4dp"
        android:fontFamily="monospace"
        android:text="● ○ ○ ○"
        android:textColor="#00FF41"
        android:textSize="12sp"
        android:letterSpacing="0.3"/>

    <!-- SCROLL HORIZONTAL — ocupa todo el espacio disponible -->
    <HorizontalScrollView
        android:id="@+id/scrollTutorial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/tvSwipeHint"
        android:layout_above="@id/tvPageIndicator"
        android:layout_marginTop="6dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- TARJETA 1 — PASOS (con ScrollView vertical) -->
            <ScrollView
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#AA1A1A1A">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="PASOS:"
                        android:textColor="#00FF41"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="1️⃣  Toca una puerta"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="2️⃣  Toca los objetos"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="3️⃣  Lee y responde"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="4️⃣  Resuelve 3 acertijos"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="5️⃣  Abre la puerta"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp"/>

                </LinearLayout>
            </ScrollView>

            <!-- TARJETA 2 — PYTHON (con ScrollView vertical) -->
            <ScrollView
                android:layout_width="260dp"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="#AA1A3A1A">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="🐍 PYTHON"
                        android:textColor="#00FF41"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Pregunta:"
                        android:textColor="#555555"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#1A1A1A"
                        android:fontFamily="monospace"
                        android:text="¿Cómo imprimes\n'Hola' en Python?"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"
                        android:padding="8dp"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Respuesta:"
                        android:textColor="#555555"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#0D200D"
                        android:fontFamily="monospace"
                        android:text="print('Hola')"
                        android:textColor="#00FF41"
                        android:textSize="13sp"
                        android:padding="8dp"/>

                </LinearLayout>
            </ScrollView>

            <!-- TARJETA 3 — JAVA (con ScrollView vertical) -->
            <ScrollView
                android:layout_width="260dp"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="#AA3A2A00">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="☕ JAVA"
                        android:textColor="#FFE03E"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Pregunta:"
                        android:textColor="#555555"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#1A1A1A"
                        android:fontFamily="monospace"
                        android:text="¿Cómo muestras\n'Hola' en Java?"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"
                        android:padding="8dp"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Respuesta:"
                        android:textColor="#555555"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#201500"
                        android:fontFamily="monospace"
                        android:text="System.out.println(&#34;Hola&#34;)"
                        android:textColor="#FFE03E"
                        android:textSize="13sp"
                        android:padding="8dp"/>

                </LinearLayout>
            </ScrollView>

            <!-- TARJETA 4 — KOTLIN (con ScrollView vertical) -->
            <ScrollView
                android:layout_width="260dp"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="#AA1A1A3A">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="🤖 KOTLIN"
                        android:textColor="#CC3EFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Pregunta:"
                        android:textColor="#555555"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#1A1A1A"
                        android:fontFamily="monospace"
                        android:text="¿Cómo imprimes\n'Hola' en Kotlin?"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"
                        android:padding="8dp"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Respuesta:"
                        android:textColor="#555555"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#0D0D20"
                        android:fontFamily="monospace"
                        android:text="println(&#34;Hola&#34;)"
                        android:textColor="#CC3EFF"
                        android:textSize="13sp"
                        android:padding="8dp"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#1A3A1A"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="💡 Solo escribe\nlas palabras clave"
                        android:textColor="#00FF41"
                        android:textSize="11sp"/>

                </LinearLayout>
            </ScrollView>

        </LinearLayout>
    </HorizontalScrollView>

</RelativeLayout>