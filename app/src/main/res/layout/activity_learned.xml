<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000" />

    <!-- Título arriba fijo -->
    <TextView
        android:id="@+id/tvLearnedTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="📚 ¿QUÉ APRENDISTE?"
        android:textColor="#00FF41"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="#EE000000"
        android:padding="10dp"/>

    <View
        android:id="@+id/lineDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/tvLearnedTitle"
        android:background="#00FF41" />

    <!-- Botón volver abajo fijo -->
    <Button
        android:id="@+id/btnBackLearned"
        android:layout_width="160dp"
        android:layout_height="44dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#00FF41"
        android:fontFamily="monospace"
        android:text="← VOLVER"
        android:textColor="#0A0A0A"
        android:textSize="13sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/lineAboveBtn"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/btnBackLearned"
        android:background="#00FF41" />

    <!-- 3 columnas entre título y botón -->
    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/lineDivider"
        android:layout_above="@id/lineAboveBtn"
        android:orientation="horizontal"
        android:weightSum="3"
        android:padding="10dp">

        <!-- Python -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#AA1A3A1A"
            android:padding="10dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="🐍 PYTHON"
                android:textColor="#00FF41"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ print() para mostrar\n   mensajes en pantalla"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ Variables para\n   guardar datos"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ if/for para\n   controlar el flujo"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ def para crear\n   funciones propias"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ Listas [] y\n   diccionarios {}"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ try/except para\n   manejar errores"
                android:textColor="#AAAAAA"
                android:textSize="11sp"/>

        </LinearLayout>

        <!-- Java -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#AA3A2A00"
            android:padding="10dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="☕ JAVA"
                android:textColor="#00FF41"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ System.out.println()\n   para mostrar datos"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ Tipos de datos\n   fuertemente tipados"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ POO: Clases,\n   Herencia e Interfaces"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ Estructuras for/while\n   y condicionales if"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ Colecciones:\n   ArrayList y Mapas"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ Manejo de errores\n   con try/catch"
                android:textColor="#AAAAAA"
                android:textSize="11sp"/>

        </LinearLayout>

        <!-- Kotlin -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#AA1A1A3A"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="☕ KOTLIN"
                android:textColor="#00FF41"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ println() para\n   mostrar mensajes"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ val/var para\n   declarar variables"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ if/for para\n   controlar el flujo"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ fun para crear\n   funciones propias"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ class para crear\n   objetos propios"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="✅ when para evaluar\n   múltiples casos"
                android:textColor="#AAAAAA"
                android:textSize="11sp"/>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>